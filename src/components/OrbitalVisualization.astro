<figure class="orbit" aria-labelledby="orbital-caption">
  <figcaption class="orbit__header" id="orbital-caption">Orbital trajectories</figcaption>
  <button class="orbit__motion" type="button" aria-label="Pause orbital animation" data-orbit-toggle hidden>
    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
      <path class="orbit__pause" d="M7 5.5v9m6-9v9" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" />
      <path class="orbit__play" d="m7 5 7 5-7 5Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" />
    </svg>
  </button>

  <svg class="orbit__chart" viewBox="0 0 560 414" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="orbit-halo">
        <stop stop-color="#3b82f6" stop-opacity=".23" />
        <stop offset="1" stop-color="#3b82f6" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="orbit-sphere" cx=".35" cy=".28" r=".78">
        <stop stop-color="#245183" />
        <stop offset=".66" stop-color="#142b49" />
        <stop offset="1" stop-color="#0b192d" />
      </radialGradient>
      <linearGradient id="orbit-limb" x1="226" y1="148" x2="350" y2="262" gradientUnits="userSpaceOnUse">
        <stop stop-color="#a5f3fc" stop-opacity=".92" />
        <stop offset=".45" stop-color="#60a5fa" stop-opacity=".78" />
        <stop offset="1" stop-color="#3b82f6" stop-opacity=".24" />
      </linearGradient>
      <clipPath id="orbit-sphere-clip">
        <circle cx="280" cy="207" r="65" />
      </clipPath>
    </defs>

    <circle cx="280" cy="207" r="192" fill="url(#orbit-halo)" />

    <g class="orbit__references">
      <path d="M24 207h512M280 14v386" stroke-dasharray="3 6" />
      <circle cx="280" cy="207" r="117" stroke-dasharray="2 6" />
      <circle cx="280" cy="207" r="158" stroke-dasharray="2 7" />
      <path d="M62 201v12m42-9v6m42-6v6m42-6v6m184-6v6m42-6v6m42-6v6m42-9v12M274 37h12m-9 42h6m-6 42h6m-6 172h6m-6 42h6m-9 42h12" />
      <path d="M24 50V30h20m472 0h20v20M24 364v20h20m472 0h20v-20" />
    </g>

    <g fill="#a5d8ff">
      <circle cx="113" cy="77" r="1.1" opacity=".65" />
      <circle cx="194" cy="66" r="1.2" opacity=".36" />
      <circle cx="473" cy="107" r="1.05" opacity=".6" />
      <circle cx="441" cy="315" r="1.1" opacity=".72" />
      <circle cx="109" cy="304" r="1.1" opacity=".52" />
      <circle cx="373" cy="350" r="1.05" opacity=".42" />
      <circle cx="506" cy="266" r="1.2" opacity=".42" />
      <circle cx="59" cy="141" r="1.1" opacity=".4" />
    </g>

    <g transform="translate(280 207) rotate(22) scale(1 .47)">
      <circle class="orbit__track orbit__track--secondary" r="202" vector-effect="non-scaling-stroke" />
      <g class="orbit__node" style="--phase: 203deg; --period: 54s">
        <circle cx="202" r="12" fill="#67e8f9" opacity=".12" />
        <circle cx="202" r="4.6" fill="#b8f4fc" />
      </g>
    </g>

    <g transform="translate(280 207) rotate(-69) scale(1 .58)">
      <circle class="orbit__track orbit__track--inclined" r="172" vector-effect="non-scaling-stroke" />
      <g class="orbit__node" style="--phase: 284deg; --period: 47s">
        <circle cx="172" r="10" fill="#60a5fa" opacity=".18" />
        <circle cx="172" r="4.5" fill="#93c5fd" />
      </g>
    </g>

    <circle cx="280" cy="207" r="73" stroke="#6ca9eb" stroke-opacity=".16" />
    <circle cx="280" cy="207" r="65" fill="url(#orbit-sphere)" stroke="url(#orbit-limb)" stroke-width="1.25" />
    <g clip-path="url(#orbit-sphere-clip)">
      <g class="orbit__meridians" transform="rotate(-20 280 207)">
        <ellipse cx="280" cy="207" rx="21" ry="65" />
        <ellipse cx="280" cy="207" rx="45" ry="65" />
        <path d="M215 207h130m-124-27c28 13 90 13 118 0m-118 54c28-13 90-13 118 0M280 142v130" />
      </g>
    </g>

    <g transform="translate(280 207) rotate(-27) scale(1 .41)">
      <circle class="orbit__track orbit__track--primary" r="223" vector-effect="non-scaling-stroke" />
      <path d="M-105 197A223 223 0 0 0 208 80" stroke="#67e8f9" stroke-opacity=".68" vector-effect="non-scaling-stroke" />
      <g class="orbit__node" style="--phase: 79deg; --period: 38s">
        <circle cx="223" r="14" fill="#67e8f9" opacity=".17" />
        <circle cx="223" r="7.2" fill="#67e8f9" opacity=".36" />
        <circle cx="223" r="4.5" fill="#ddfcff" />
      </g>
    </g>
  </svg>

  <div class="orbit__legend" aria-hidden="true">
    <span><i class="orbit__key orbit__key--path"></i>Orbital path</span>
    <span><i class="orbit__key orbit__key--node"></i>Orbital node</span>
  </div>
</figure>

<style>
  .orbit {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--folio-border);
    border-radius: calc(var(--folio-radius) + 0.25rem);
    background:
      radial-gradient(ellipse at 54% 45%, #142b48 0%, transparent 70%),
      linear-gradient(143deg, #122137, #0b1528 76%);
  }

  .orbit::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(rgb(118 168 222 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(118 168 222 / 7%) 1px, transparent 1px);
    background-size: 1.75rem 1.75rem;
    mask-image: radial-gradient(ellipse at center, black 28%, transparent 82%);
  }

  .orbit__header,
  .orbit__legend {
    z-index: 1;
    display: flex;
    align-items: center;
    margin-inline: clamp(0.875rem, 2.5vw, 1.4rem);
    color: var(--folio-muted);
    font-family: var(--folio-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .orbit__header {
    min-height: 3.5rem;
    border-bottom: 1px solid rgb(116 166 219 / 15%);
    color: #b9d2ee;
    font-weight: 550;
  }

  .orbit__motion {
    position: absolute;
    z-index: 2;
    top: 0.375rem;
    right: clamp(0.875rem, 2.5vw, 1.4rem);
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    color: #b9d2ee;
  }

  .orbit__motion[hidden],
  .orbit__play,
  .orbit[data-paused] .orbit__pause {
    display: none;
  }

  .orbit[data-paused] .orbit__play {
    display: initial;
  }

  .orbit__motion:hover {
    border-color: var(--folio-border);
    background: var(--folio-surface);
    color: var(--folio-highlight);
  }

  .orbit__motion:focus-visible {
    outline: 2px solid var(--folio-highlight);
    outline-offset: 2px;
  }

  .orbit__chart {
    position: relative;
    width: 100%;
    height: auto;
  }

  .orbit__references,
  .orbit__meridians {
    stroke: #86baff;
    stroke-opacity: 0.22;
  }

  .orbit__meridians {
    stroke-opacity: 0.3;
  }

  .orbit__track--primary {
    stroke: #7dd3fc;
    stroke-opacity: 0.6;
  }

  .orbit__track--secondary {
    stroke: #70a8db;
    stroke-opacity: 0.57;
  }

  .orbit__track--inclined {
    stroke: #759feb;
    stroke-opacity: 0.48;
  }

  .orbit__node {
    transform: rotate(var(--phase));
    transform-origin: 0 0;
  }

  .orbit__legend {
    min-height: 3.15rem;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    border-top: 1px solid rgb(116 166 219 / 15%);
  }

  .orbit__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .orbit__key--path {
    width: 0.875rem;
    height: 1px;
    background: #7dd3fc;
  }

  .orbit__key--node {
    width: 0.35rem;
    height: 0.35rem;
    margin-inline: 0.26rem;
    border-radius: 50%;
    background: #a5f3fc;
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit[data-motion-ready] .orbit__node {
      animation: travel var(--period) linear infinite;
    }

    .orbit[data-paused] .orbit__node {
      animation-play-state: paused;
    }

    .orbit__motion {
      transition: color var(--folio-speed) ease, background-color var(--folio-speed) ease,
        border-color var(--folio-speed) ease;
    }
  }

  @keyframes travel {
    to { transform: rotate(calc(var(--phase) + 360deg)); }
  }
</style>

<script>
  const control = document.querySelector<HTMLButtonElement>("[data-orbit-toggle]");
  const figure = control?.closest("figure");

  if (control && figure) {
    const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
    const syncMotion = () => {
      control.hidden = !motion.matches;
      figure.toggleAttribute("data-motion-ready", motion.matches);
    };

    syncMotion();
    motion.addEventListener("change", syncMotion);
    control.addEventListener("click", () => {
      const paused = figure.toggleAttribute("data-paused");
      control.setAttribute("aria-label", paused ? "Play orbital animation" : "Pause orbital animation");
    });
  }
</script>
