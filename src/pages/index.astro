---
import OrbitalVisualization from "../components/OrbitalVisualization.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";

const baseUrl = import.meta.env.BASE_URL;

const focusAreas = [
  {
    title: "Robotics & Autonomous Systems",
    description: "Perception and decision-making for mobile robots in unstructured environments.",
    icon: "M5 11V8l3-3h8l3 3v3M4 11h16v7H4zM8 14h.01m7.99 0h.01M9 20h6M12 5V2m0 0h.01",
  },
  {
    title: "Computer Vision & Perception",
    description: "Deep learning for scene understanding, segmentation, and spatial perception.",
    icon: "M3 8V4h4m10 0h4v4m0 8v4h-4M7 20H3v-4m0-4s3.6-5 9-5 9 5 9 5-3.6 5-9 5-9-5-9-5Zm11.5 0a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z",
  },
  {
    title: "Space AI & Earth Observation",
    description: "Machine learning for satellite imagery analysis and autonomous space operations.",
    icon: "M18.5 12a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Zm-4-6s2.3 2.5 2.3 6-2.3 6-2.3 6M7 10h10m-2 4H7m-4 3c-1.1-1.9 2.1-6 7.1-9s10-4 11.1-2.1c1.1 1.9-2.1 6-7.1 9s-10 4-11.1 2.1Z",
  },
  {
    title: "Edge AI & Deployment",
    description: "Model optimization, quantization, and inference on compute-constrained hardware.",
    icon: "M7 7h10v10H7zM10 10h4v4h-4zM9 3v4m6-4v4M9 17v4m6-4v4M3 9h4m-4 6h4m10-6h4m-4 6h4",
  },
];

const featuredProjects = [
  {
    title: "Bird's Eye View in Planetary Rovers",
    image: "project-rover.jpg",
    imageAlt: "Rover diagram surrounded by camera views of lunar terrain",
    width: 545,
    height: 445,
    diagram: true,
    summary: "Deep learning-based perception and obstacle mapping, for planetary robotic systems.",
    tags: ["Python", "PyTorch", "MLflow"],
    href: "https://github.com/danielmarek22/leveraging-bev-rovers",
  },
  {
    title: "Resource Frugal Depth Estimation",
    image: "project-depth.jpg",
    imageAlt: "Color-coded depth map of a rocky scene",
    width: 320,
    height: 256,
    summary:
      "Stereo-based depth estimation using state-of-the-art deep learning models for resource-constrained systems.",
    tags: ["PyTorch", "Open3D", "OpenCV"],
    href: "https://github.com/danielmarek22/rover-stereo-depth",
  },
  {
    title: "Planetary Rock Segmentation using Deep Learning",
    image: "project-rock.jpg",
    imageAlt: "Segmentation overlay highlighting rocks on rendered planetary terrain",
    width: 320,
    height: 320,
    summary:
      "Deep learning-based segmentation of extraterrestrial terrain, focused on reliable on-board inference for planetary exploration systems.",
    tags: ["TensorFlow", "OpenCV", "Embedded optimization"],
    href: "https://github.com/danielmarek22/onboard-rock-segmentation",
  },
];

const astra = {
  title: "Project Astra",
  subtitle: "Local Autonomous AI Agent",
  summary:
    "An experimental local AI agent combining persistent memory, tool use, autonomous workflows, and multimodal interaction in a modular architecture.",
  tags: ["Python", "Local LLMs", "Agent Architecture", "Memory Systems"],
  href: "https://danielmarek22.github.io/astra-demo/",
};

const techCategories = [
  {
    title: "AI & Deep Learning",
    logos: [
      { file: "pytorch.svg", name: "PyTorch" },
      { file: "tensorflow.svg", name: "TensorFlow" },
      { file: "sklearn.svg", name: "scikit-learn" },
      { file: "opencv.svg", name: "OpenCV" },
      { file: "lightning.svg", name: "Lightning" },
      { file: "numpy.svg", name: "NumPy" },
      { file: "pandas.svg", name: "pandas", lightBackground: true },
      { file: "matplotlib.svg", name: "Matplotlib" },
    ],
  },
  {
    title: "Engineering & MLOps",
    logos: [
      { file: "python.svg", name: "Python" },
      { file: "cpp.svg", name: "C++" },
      { file: "docker.svg", name: "Docker" },
      { file: "linux.svg", name: "Linux" },
      { file: "git.svg", name: "Git" },
      { file: "mlflow.svg", name: "MLflow", lightBackground: true },
      { file: "jenkins.svg", name: "Jenkins" },
    ],
  },
  {
    title: "Robotics & 3D Perception",
    logos: [
      { file: "ros.svg", name: "ROS", lightBackground: true },
      { file: "open3d.png", name: "Open3D", lightBackground: true },
    ],
  },
  {
    title: "Autonomous AI",
    logos: [{ file: "ollama.svg", name: "Ollama", lightBackground: true }],
  },
];

const previewSections = [
  {
    title: "Publications",
    href: "papers",
    description:
      "Peer-reviewed research in deep learning, computer vision, and localization systems.",
  },
  {
    title: "Achievements",
    href: "achievements",
    description:
      "Awards, scholarships, and competitive recognitions in space-oriented machine learning research.",
  },
];

const contacts = [
  { label: "Email", href: "mailto:danielmarek22@gmail.com", icon: "gmail", external: false },
  { label: "GitHub", href: "https://github.com/danielmarek22", icon: "github", external: true },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/daniel-marek22",
    icon: "linkedin",
    external: true,
  },
];
---

<Layout title="Daniel Marek" orbitalHomepage>
  <div class="portfolio-home">
    <section class="portfolio-shell home-hero" aria-labelledby="home-headline">
      <div class="home-hero__copy">
        <p class="home-hero__role">Machine Learning Engineer · PhD Researcher</p>

        <h1 id="home-headline">
          Building Intelligent Autonomous <span>Systems.</span>
        </h1>

        <p class="home-hero__intro">
          I'm a Machine Learning Engineer and industrial PhD researcher working at the intersection
          of artificial intelligence, computer vision, and autonomous systems — with a focus on space
          applications and real-world deployment.
        </p>

        <div class="home-hero__actions">
          <a class="home-button home-button--primary" href="#featured-projects">
            Explore projects
            <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true">
              <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
            </svg>
          </a>
          <a class="home-button" href={`${baseUrl}about`}>About me</a>
        </div>

        <ul class="home-hero__specialties" role="list" aria-label="Specializations">
          <li>Autonomous AI</li>
          <li>Computer Vision</li>
          <li>Space Systems</li>
        </ul>
      </div>

      <OrbitalVisualization />
    </section>

    <section class="portfolio-shell home-section" aria-labelledby="scientific-focus">
      <div class="home-section__heading" data-reveal>
        <h2 id="scientific-focus">Scientific Focus</h2>
      </div>

      <div class="home-focus">
        {
          focusAreas.map((area) => (
            <article class="home-focus__card">
              <span class="home-focus__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                  <path d={area.icon} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" />
                </svg>
              </span>
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="featured-projects" class="portfolio-shell home-section" aria-labelledby="projects-title">
      <div class="home-section__heading" data-reveal>
        <h2 id="projects-title">Featured Projects</h2>
        <a class="home-text-link" href={`${baseUrl}projects`}>All projects <span aria-hidden="true">↗</span></a>
      </div>

      <div class="home-projects">
        {
          featuredProjects.map((project) => (
            <article class="home-project" data-reveal>
              <div class:list={["home-project__media", project.diagram && "home-project__media--diagram"]}>
                <img
                  src={`${baseUrl}${project.image}`}
                  alt={project.imageAlt}
                  width={project.width}
                  height={project.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="home-project__body">
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul class="home-tags" role="list" aria-label="Technologies">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <a class="home-text-link home-project__link" href={project.href}
                   aria-label={`View repository for ${project.title}`}>
                  View repository <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <article class="home-astra" data-reveal>
        <div class="home-astra__identity">
          <span class="home-astra__icon" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="36" height="36" fill="none">
              <path d="M22 4v7M22 33v7M4 22h7m22 0h7M9 9l5 5m16 16 5 5m0-26-5 5M14 30l-5 5"
                stroke="currentColor" stroke-opacity=".55" stroke-width="1.2" stroke-linecap="round" />
              <rect x="14" y="14" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.5" />
              <path d="M22 18v8m-4-4h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <div>
            <h3>{astra.title}</h3>
            <p class="home-astra__subtitle">{astra.subtitle}</p>
          </div>
        </div>
        <div class="home-astra__description">
          <p>{astra.summary}</p>
          <ul class="home-tags" role="list" aria-label="Technologies">
            {astra.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
        <a class="home-button" href={astra.href}>
          Technical Documentation <span aria-hidden="true">↗</span>
        </a>
      </article>
    </section>

    <section class="portfolio-shell home-section" aria-labelledby="technical-stack">
      <div class="home-section__heading" data-reveal>
        <h2 id="technical-stack">Technical Stack</h2>
      </div>

      <div class="home-stack">
        {
          techCategories.map((category) => (
            <article class="home-stack__card">
              <h3>{category.title}</h3>
              <ul class="home-stack__logos" role="list">
                {
                  category.logos.map(({ file, name, lightBackground }) => (
                    <li>
                      <span class:list={["home-stack__tile", lightBackground && "home-stack__tile--light"]}>
                        <img
                          src={`${baseUrl}logos/${file}`}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                      <span>{name}</span>
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <div class="portfolio-shell home-section home-previews">
      {
        previewSections.map((section) => (
          <section class="home-preview" aria-labelledby={`preview-${section.href}`} data-reveal>
            <h2 id={`preview-${section.href}`}>{section.title}</h2>
            <p>{section.description}</p>
            <a class="home-text-link" href={`${baseUrl}${section.href}`}>
              {section.title === "Publications" ? "View publications" : "View achievements"}
              <span aria-hidden="true">↗</span>
            </a>
          </section>
        ))
      }
    </div>

    <section class="portfolio-shell home-section home-contact" aria-labelledby="contact-title">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p>
          Interested in collaboration or research opportunities in AI, robotics, or space technologies?
          Feel free to reach out.
        </p>
      </div>

      <ul class="home-contact__links" role="list">
        {
          contacts.map((contact) => (
            <li>
              <a
                class="home-button"
                href={contact.href}
                target={contact.external ? "_blank" : undefined}
                rel={contact.external ? "noopener noreferrer" : undefined}
              >
                <img
                  src={`${baseUrl}logos/${contact.icon}.svg`}
                  alt=""
                  width="19"
                  height="19"
                  loading="lazy"
                  decoding="async"
                />
                {contact.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<script>
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");

  if (motion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.setAttribute("data-revealed", "");
          observer.unobserve(entry.target);
        }
      }
    }, { threshold: 0.15 });

    document.querySelectorAll("[data-reveal]").forEach((element) => observer.observe(element));
  }
</script>
