---
import PublicationCard from "../components/PublicationCard.astro";
import { publications } from "../data/publications";
import Layout from "../layouts/Layout.astro";
import "../styles/papers.css";

const published = publications
  .filter((paper) => paper.status === "published")
  .sort((a, b) => b.citationDate.localeCompare(a.citationDate));
const underReview = publications.filter((paper) => paper.status === "under-review");
---

<Layout
  title="Publications - Daniel Marek"
  description="Published research by Daniel Marek on on-board rock segmentation and Bluetooth Low Energy indoor positioning."
  orbitalTheme
>
  <div class="publication-archive">
    <header class="portfolio-shell archive-intro">
      <p>Research Archive</p>
      <h1>Publications</h1>
    </header>

    <section class="portfolio-shell archive-section" aria-labelledby="published-research">
      <div class="archive-section__heading">
        <span aria-hidden="true">01</span>
        <h2 id="published-research">Published Research</h2>
      </div>
      <div class="archive-list">
        {published.map((publication) => <PublicationCard publication={publication} />)}
      </div>
    </section>

    {underReview.length > 0 && (
      <section class="portfolio-shell archive-section archive-section--review" aria-labelledby="manuscripts-under-review">
        <div class="archive-section__heading">
          <span aria-hidden="true">02</span>
          <h2 id="manuscripts-under-review">Manuscripts Under Review</h2>
        </div>
        <div class="archive-list">
          {underReview.map((publication) => <PublicationCard publication={publication} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
