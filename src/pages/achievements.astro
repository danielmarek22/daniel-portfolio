---
import AchievementCard from "../components/AchievementCard.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/achievements.css";

const sections = [
  {
    id: "awards-and-distinctions",
    title: "Awards & Distinctions",
    kind: "award",
    entries: [
      {
        title: "Polish Space Fellowship Program",
        label: "Finalist",
        details: "Internship program for early-career researchers in Poland’s space sector.",
        link: {
          text: "Fellowship overview",
          href: "https://arp.pl/pl/jak-dzialamy/projekty-kosmiczne/space-fellowship-program/",
        },
      },
      {
        title: "Polish Space Agency Thesis Competition",
        label: "3rd Place",
        details: "Machine learning for autonomous rover perception and obstacle detection.",
        link: {
          text: "Polish Space Agency results",
          href: "https://polsa.gov.pl/wydarzenia/nagroda-prezesa-polsa-za-najlepsza-prace-dyplomowa-znamy-zwyciezcow-edycji-2024/",
        },
      },
      {
        title: "TRUMPF Huettinger Engineering Thesis Competition",
        label: "3rd Place",
        details: "Research on extraterrestrial rock segmentation.",
        link: {
          text: "TRUMPF competition coverage",
          href: "https://mikrokontroler.pl/2024/06/14/trumpf-nagrodzil-w-konkursie-najlepsze-prace-dyplomowe-studentow-i-absolwentow-polskich-uczelni-technicznych/",
        },
      },
    ],
  },
  {
    id: "programs-and-scholarships",
    title: "Programs & Scholarships",
    kind: "program",
    entries: [
      {
        title: "spACE Camp 2026",
        label: "Selected participant",
        details: "University of Warsaw Incubator",
        link: {
          text: "spACE Camp participants",
          href: "https://spaceconference26.uw.edu.pl/camp/",
        },
      },
      {
        title: "Rector’s Scholarship for Academic Excellence",
        label: "Academic year 2023–2024",
        details: "Silesian University of Technology",
      },
    ],
  },
  {
    id: "certifications",
    title: "Certifications",
    kind: "certification",
    entries: [
      {
        title: "LanguageCert Test of English",
        details: "C2 Proficiency",
      },
      {
        title: "AgilePM® Foundation",
      },
    ],
  },
  {
    id: "conferences-and-activities",
    title: "Conferences & Activities",
    kind: "activity",
    entries: [
      {
        title: "Gekkon 2024",
        label: "Speaker",
        details: "Planetary Rovers Through the Decades and How AI Is Changing Space Exploration",
      },
      {
        title: "In@Security 2025",
        label: "Co-organizer",
      },
    ],
  },
] as const;
---

<Layout
  title="Achievements - Daniel Marek"
  description="Daniel Marek’s awards, scholarships, certifications, and conference activities."
  orbitalTheme
>
  <div class="achievements-page">
    <header class="portfolio-shell achievements-intro">
      <h1>Achievements &amp; <span>Recognition</span></h1>
    </header>

    <div class="portfolio-shell achievements-sections">
      {sections.map(({ id, title, kind, entries }, index) => (
        <section class={`achievements-section achievements-section--${kind}`} aria-labelledby={id}>
          <div class="achievements-section__heading">
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h2 id={id}>{title}</h2>
          </div>
          <ul class="achievements-list" role="list">
            {entries.map((entry) => (
              <li><AchievementCard kind={kind} {...entry} /></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>
