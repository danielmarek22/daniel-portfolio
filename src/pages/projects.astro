---
import ProjectCard from "../components/ProjectCard.astro";
import { projectSections } from "../data/projects";
import Layout from "../layouts/Layout.astro";
import "../styles/projects.css";
---

<Layout
  title="Projects - Daniel Marek"
  description="Daniel Marek's industrial and academic research in Earth observation and robotics, and independent R&D on Project Astra and ELARA."
  orbitalTheme
>
  <div class="research-page">
    <section class="portfolio-shell research-intro" aria-labelledby="research-title">
      <h1 id="research-title">Projects &amp; <span>Research</span></h1>
      <p>Exploring intelligent systems through applied research, robotic perception, and autonomous AI.</p>

      <nav class="research-nav" aria-label="Project categories">
        {projectSections.map(({ id, title }) => (
          <a href={`#${id}`}>
            {title}
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
              <path d="M8 3v10m-4-4 4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" />
            </svg>
          </a>
        ))}
      </nav>
    </section>

    {projectSections.map(({ id, title, projects }, index) => (
      <section
        class="portfolio-shell research-section"
        id={id}
        aria-labelledby={`${id}-title`}
      >
        <div class="research-section__heading">
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h2 id={`${id}-title`}>{title}</h2>
        </div>
        <div class="research-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    ))}
  </div>
</Layout>
