---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  orbitalHomepage?: boolean;
  orbitalTheme?: boolean;
}

const {
  title = "Daniel Marek",
  description = "Daniel Marek, AI and autonomous systems engineer and industrial PhD researcher working on computer vision, robotic perception, space AI, and edge deployment.",
  orbitalHomepage = false,
  orbitalTheme = orbitalHomepage,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const navLinks = [
  { href: "", label: "Home" },
  { href: "about", label: "About" },
  { href: "projects", label: "Projects" },
  { href: "papers", label: "Publications" },
  { href: "achievements", label: "Achievements" },
].map(({ href, label }) => {
  const path = `${baseUrl}${href}`;
  return { path, label, active: path.replace(/\/$/, "") === currentPath };
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class:list={[
    "relative overflow-x-hidden font-sans text-slate-200",
    orbitalTheme ? "orbital-page" : "bg-[#0b1020]",
  ]}>
    {!orbitalTheme && (
      <div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
        <div
          class="drift-slow absolute left-[-10%] top-[-20%] h-[800px] w-[800px] rounded-full bg-cyan-500/25 blur-[150px]"
        ></div>
        <div
          class="drift-slower absolute bottom-[-20%] right-[-10%] h-[700px] w-[700px] rounded-full bg-blue-600/20 blur-[150px]"
        ></div>
      </div>
    )}

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-site-header>
      <div class="portfolio-shell site-header__inner">
        <a href={baseUrl} class="site-brand">
          <span class="site-brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
              <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.25" />
              <ellipse
                cx="12" cy="12" rx="10" ry="4.1"
                transform="rotate(-37 12 12)"
                stroke="currentColor" stroke-width="1.25"
              />
              <circle cx="19.1" cy="6.2" r="1.45" fill="currentColor" />
            </svg>
          </span>
          <span>Daniel Marek</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          {
            navLinks.map(({ path, label, active }) => (
              <a href={path} class="site-link" aria-current={active ? "page" : undefined}>{label}</a>
            ))
          }
        </nav>

        <details class="site-menu" data-site-menu>
          <summary>
            Menu
            <svg viewBox="0 0 20 20" fill="none" width="16" height="16" aria-hidden="true">
              <path d="m5 8 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
            </svg>
          </summary>
          <nav class="site-menu__panel" aria-label="Main navigation">
            {
              navLinks.map(({ path, label, active }) => (
                <a href={path} class="site-link" aria-current={active ? "page" : undefined}>{label}</a>
              ))
            }
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" class="relative z-10" tabindex="-1">
      <slot />
    </main>

    <script>
      const header = document.querySelector("[data-site-header]");
      const updateHeader = () => header?.toggleAttribute("data-scrolled", window.scrollY > 24);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
      const menuSummary = menu?.querySelector("summary");

      menu?.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          menu.open = false;
          menuSummary?.focus();
        }
      });

      menu?.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          menu.open = false;
        }
      });
    </script>
  </body>
</html>
